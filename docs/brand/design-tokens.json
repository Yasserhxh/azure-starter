{
  "$description": "TodoApp design tokens — W3C Design Tokens Community Group format. Single source of truth for all design values. Placeholder brand until a client charte graphique replaces it. Regenerate outputs with tools/tokens (Phase 5).",
  "primitive": {
    "color": {
      "indigo": {
        "500": { "$type": "color", "$value": "#5B5BD6" },
        "400": { "$type": "color", "$value": "#8E8CF0" }
      },
      "teal": {
        "500": { "$type": "color", "$value": "#0FB5A6" },
        "400": { "$type": "color", "$value": "#2DD4BF" }
      },
      "neutral": {
        "0":   { "$type": "color", "$value": "#FFFFFF" },
        "50":  { "$type": "color", "$value": "#F7F7FB" },
        "100": { "$type": "color", "$value": "#EDEDF4" },
        "200": { "$type": "color", "$value": "#D9D9E4" },
        "400": { "$type": "color", "$value": "#9A9AAE" },
        "600": { "$type": "color", "$value": "#5A5A6E" },
        "800": { "$type": "color", "$value": "#23232E" },
        "900": { "$type": "color", "$value": "#15151C" },
        "950": { "$type": "color", "$value": "#0B0B12" }
      },
      "green":  { "500": { "$type": "color", "$value": "#1A8F57" }, "400": { "$type": "color", "$value": "#3DD68C" } },
      "amber":  { "500": { "$type": "color", "$value": "#B45309" }, "400": { "$type": "color", "$value": "#F59E0B" } },
      "red":    { "500": { "$type": "color", "$value": "#C0352B" }, "400": { "$type": "color", "$value": "#F87171" } }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "xs":   { "$type": "dimension", "$value": "0.75rem" },
      "sm":   { "$type": "dimension", "$value": "0.875rem" },
      "base": { "$type": "dimension", "$value": "1rem" },
      "lg":   { "$type": "dimension", "$value": "1.125rem" },
      "xl":   { "$type": "dimension", "$value": "1.25rem" },
      "2xl":  { "$type": "dimension", "$value": "1.5rem" },
      "3xl":  { "$type": "dimension", "$value": "1.875rem" },
      "4xl":  { "$type": "dimension", "$value": "2.25rem" },
      "5xl":  { "$type": "dimension", "$value": "3rem" }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0" },
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "0.375rem" },
    "md":   { "$type": "dimension", "$value": "0.5rem" },
    "lg":   { "$type": "dimension", "$value": "0.75rem" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": { "inset": false, "color": "#0B0B1226", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" } },
    "md": { "$type": "shadow", "$value": { "inset": false, "color": "#0B0B1229", "offsetX": "0px", "offsetY": "4px", "blur": "8px", "spread": "-2px" } },
    "lg": { "$type": "shadow", "$value": { "inset": false, "color": "#0B0B122E", "offsetX": "0px", "offsetY": "12px", "blur": "24px", "spread": "-6px" } }
  },
  "semantic": {
    "light": {
      "color": {
        "bg":        { "$type": "color", "$value": "{primitive.color.neutral.0}" },
        "surface":   { "$type": "color", "$value": "{primitive.color.neutral.50}" },
        "border":    { "$type": "color", "$value": "{primitive.color.neutral.200}" },
        "text":      { "$type": "color", "$value": "{primitive.color.neutral.900}" },
        "text-muted":{ "$type": "color", "$value": "{primitive.color.neutral.600}" },
        "primary":   { "$type": "color", "$value": "{primitive.color.indigo.500}" },
        "accent":    { "$type": "color", "$value": "{primitive.color.teal.500}" },
        "success":   { "$type": "color", "$value": "{primitive.color.green.500}" },
        "warning":   { "$type": "color", "$value": "{primitive.color.amber.500}" },
        "danger":    { "$type": "color", "$value": "{primitive.color.red.500}" }
      }
    },
    "dark": {
      "color": {
        "bg":        { "$type": "color", "$value": "{primitive.color.neutral.950}" },
        "surface":   { "$type": "color", "$value": "{primitive.color.neutral.900}" },
        "border":    { "$type": "color", "$value": "{primitive.color.neutral.800}" },
        "text":      { "$type": "color", "$value": "{primitive.color.neutral.50}" },
        "text-muted":{ "$type": "color", "$value": "{primitive.color.neutral.400}" },
        "primary":   { "$type": "color", "$value": "{primitive.color.indigo.400}" },
        "accent":    { "$type": "color", "$value": "{primitive.color.teal.400}" },
        "success":   { "$type": "color", "$value": "{primitive.color.green.400}" },
        "warning":   { "$type": "color", "$value": "{primitive.color.amber.400}" },
        "danger":    { "$type": "color", "$value": "{primitive.color.red.400}" }
      }
    }
  }
}
