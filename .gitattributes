# Normalize line endings to LF in the repo (cross-platform: Windows dev, Linux CI).
* text=auto eol=lf

# Explicit text types
*.cs       text eol=lf
*.csproj   text eol=lf
*.props    text eol=lf
*.targets  text eol=lf
*.slnx     text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.bicep    text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.css      text eol=lf
*.dart     text eol=lf
*.sh       text eol=lf

# Windows-only scripts keep CRLF
*.ps1      text eol=crlf
*.cmd      text eol=crlf
*.bat      text eol=crlf

# Binary (never normalize)
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.pfx      binary
*.snk      binary
*.woff     binary
*.woff2    binary
